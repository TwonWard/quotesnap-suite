"use client";

import { useEffect, useState, useMemo, useRef } from "react";
// No external icons needed - stub components so build works without lucide-react
const Icon = ({ children, className }: any) => <span className={className}>{children}</span>;
const Search = (p: any) => <span {...p}>🔍</span>;
const Plus = (p: any) => <span {...p}>+</span>;
const Trash2 = (p: any) => <span {...p}>🗑️</span>;
const FileText = (p: any) => <span {...p}>📄</span>;
const Eye = (p: any) => <span {...p}>👁️</span>;
const Printer = (p: any) => <span {...p}>🖨️</span>;
const Send = (p: any) => <span {...p}>✉️</span>;
const Check = (p: any) => <span {...p}>✓</span>;
const X = (p: any) => <span {...p}>✕</span>;
const MoreHorizontal = (p: any) => <span {...p}>⋯</span>;
const Sparkles = (p: any) => <span {...p}>✨</span>;
const Calendar = (p: any) => <span {...p}>📅</span>;
const DollarSign = (p: any) => <span {...p}>$</span>;
const LayoutDashboard = (p: any) => <span {...p}>▦</span>;


/*
  Supabase Ready - Sprint 2 Integration
  --------------------------------------
  import { createClient } from '@supabase/supabase-js'

  const supabaseUrl = process.env.NEXT_PUBLIC_SUPABASE_URL // https://vlpbbnaitemstwrjxyat.supabase.co
  const supabaseKey = process.env.NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY

  const supabase = createClient(supabaseUrl, supabaseKey)

  // Sprint 2: Replace localStorage with:
  // const { data, error } = await supabase.from('quotes').select('*')
  // await supabase.from('quotes').upsert(quote)
  // Saving to Supabase will be implemented in Sprint 2. For now, using localStorage (client-side only).
*/

type LineItem = {
  id: string;
  description: string;
  qty: number;
  rate: number;
};

type QuoteStatus = "Draft" | "Sent" | "Approved";

type Quote = {
  id: string;
  clientName: string;
  email: string;
  phone: string;
  address: string;
  jobSite: string;
  lineItems: LineItem[];
  taxRate: number;
  discount: number;
  notes: string;
  terms: string;
  status: QuoteStatus;
  createdAt: string;
  updatedAt: string;
};

const SAMPLE_QUOTES: Quote[] = [
  {
    id: "qs_1",
    clientName: "Harrison & Co. Residence",
    email: "sarah.harrison@gmail.com",
    phone: "(415) 555-0142",
    address: "2489 Filbert St, San Francisco, CA 94123",
    jobSite: "2489 Filbert St, SF - Full kitchen + deck",
    lineItems: [
      { id: "1", description: "Kitchen cabinet install + hardware", qty: 1, rate: 4850 },
      { id: "2", description: "Quartz countertop fabrication & install", qty: 42, rate: 95 },
      { id: "3", description: "Electrical - recessed lighting (6)", qty: 6, rate: 185 },
    ],
    taxRate: 8.5,
    discount: 400,
    notes: "Client prefers matte black hardware. 50% deposit to schedule.",
    terms: "Valid for 14 days. 2-year workmanship warranty.",
    status: "Sent",
    createdAt: new Date(Date.now() - 86400000 * 2).toISOString(),
    updatedAt: new Date(Date.now() - 86400000 * 2).toISOString(),
  },
  {
    id: "qs_2",
    clientName: "Midtown Office Buildout",
    email: "ops@midtowncreative.co",
    phone: "(415) 555-0299",
    address: "555 Market St, Suite 1200, SF",
    jobSite: "555 Market - Lobby & conference",
    lineItems: [
      { id: "1", description: "Demo & framing - conference walls", qty: 1, rate: 3200 },
      { id: "2", description: "Drywall, tape, paint - 2 coats", qty: 850, rate: 4.5 },
    ],
    taxRate: 0,
    discount: 0,
    notes: "After-hours access required. Building manager: Leo.",
    terms: "Net 15. Change orders billed at $125/hr.",
    status: "Draft",
    createdAt: new Date(Date.now() - 86400000 * 5).toISOString(),
    updatedAt: new Date(Date.now() - 86400000 * 1).toISOString(),
  },
];

const fmtCurrency = (n: number) =>
  new Intl.NumberFormat("en-US", { style: "currency", currency: "USD" }).format(
    isNaN(n) ? 0 : n
  );
const fmtDate = (iso: string) =>
  new Date(iso).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });

function calcTotals(items: LineItem[], taxRate: number, discount: number) {
  const subtotal = items.reduce((s, it) => s + (Number(it.qty) || 0) * (Number(it.rate) || 0), 0);
  const taxAmount = subtotal * ((Number(taxRate) || 0) / 100);
  const total = subtotal + taxAmount - (Number(discount) || 0);
  return { subtotal, taxAmount, total: Math.max(0, total) };
}

export default function App() {
  const [quotes, setQuotes] = useState<Quote[]>([]);
  const [search, setSearch] = useState("");
  const [statusFilter, setStatusFilter] = useState<QuoteStatus | "All">("Draft");
  const [editing, setEditing] = useState<Quote | null>(null);
  const [previewOpen, setPreviewOpen] = useState(false);
  const [toast, setToast] = useState<string | null>(null);
  const editorRef = useRef<HTMLDivElement>(null);

  // Load
  useEffect(() => {
    const raw = localStorage.getItem("quotesnap-quotes");
    if (raw) {
      try {
        const parsed = JSON.parse(raw) as Quote[];
        if (parsed.length > 0) {
          setQuotes(parsed);
          return;
        }
      } catch {}
    }
    // seed if empty for polished SaaS feel
    setQuotes(SAMPLE_QUOTES);
  }, []);

  // Persist
  useEffect(() => {
    if (quotes.length) {
      localStorage.setItem("quotesnap-quotes", JSON.stringify(quotes));
    }
  }, [quotes]);

  useEffect(() => {
    if (toast) {
      const t = setTimeout(() => setToast(null), 2800);
      return () => clearTimeout(t);
    }
  }, [toast]);

  const filtered = useMemo(() => {
    return quotes
      .filter((q) => {
        if (statusFilter !== "All" && q.status !== statusFilter) return false;
        if (!search.trim()) return true;
        const s = search.toLowerCase();
        return (
          q.clientName.toLowerCase().includes(s) ||
          q.email.toLowerCase().includes(s) ||
          q.jobSite.toLowerCase().includes(s)
        );
      })
      .sort((a, b) => new Date(b.updatedAt).getTime() - new Date(a.updatedAt).getTime());
  }, [quotes, search, statusFilter]);

  const totals = useMemo(() => {
    if (!editing) return { subtotal: 0, taxAmount: 0, total: 0 };
    return calcTotals(editing.lineItems, editing.taxRate, editing.discount);
  }, [editing]);

  const newQuote = () => {
    const now = new Date().toISOString();
    const q: Quote = {
      id: `qs_${Date.now()}`,
      clientName: "",
      email: "",
      phone: "",
      address: "",
      jobSite: "",
      lineItems: [{ id: `${Date.now()}`, description: "", qty: 1, rate: 0 }],
      taxRate: 0,
      discount: 0,
      notes: "",
      terms: "Valid for 14 days. Payment terms: 50% deposit, balance on completion.",
      status: "Draft",
      createdAt: now,
      updatedAt: now,
    };
    setEditing(q);
    setTimeout(() => editorRef.current?.scrollTo({ top: 0, behavior: "smooth" }), 50);
  };

  const saveQuote = () => {
    if (!editing) return;
    if (!editing.clientName.trim()) {
      setToast("Add a client name to save");
      return;
    }
    const updated: Quote = { ...editing, updatedAt: new Date().toISOString() };
    setQuotes((prev) => {
      const exists = prev.find((p) => p.id === updated.id);
      if (exists) return prev.map((p) => (p.id === updated.id ? updated : p));
      return [updated, ...prev];
    });
    setEditing(updated);
    setToast("Quote saved to this device");
  };

  const updateField = <K extends keyof Quote>(key: K, value: Quote[K]) => {
    if (!editing) return;
    setEditing({ ...editing, [key]: value });
  };

  const updateItem = (id: string, patch: Partial<LineItem>) => {
    if (!editing) return;
    setEditing({
      ...editing,
      lineItems: editing.lineItems.map((it) => (it.id === id ? { ...it, ...patch } : it)),
    });
  };

  const addItem = () => {
    if (!editing) return;
    setEditing({
      ...editing,
      lineItems: [
        ...editing.lineItems,
        { id: `${Date.now()}_${Math.random()}`, description: "", qty: 1, rate: 0 },
      ],
    });
  };

  const removeItem = (id: string) => {
    if (!editing) return;
    if (editing.lineItems.length === 1) {
      setToast("At least one line item required");
      return;
    }
    setEditing({ ...editing, lineItems: editing.lineItems.filter((i) => i.id !== id) });
  };

  const markSent = () => {
    if (!editing) return;
    const updated = { ...editing, status: "Sent" as const, updatedAt: new Date().toISOString() };
    setEditing(updated);
    setQuotes((prev) => prev.map((q) => (q.id === updated.id ? updated : q)));
    if (!quotes.find((q) => q.id === updated.id)) {
      // if new, save first
      setQuotes((prev) => [updated, ...prev.filter((p) => p.id !== updated.id)]);
    }
    setToast("Marked as Sent");
  };

  const handleSendMock = () => {
    if (!editing?.clientName) {
      setToast("Add client details first");
      return;
    }
    setToast(`Sending to ${editing.email || editing.clientName} — mocked for Sprint 1`);
  };

  return (
    <div className="min-h-screen bg-[#0a0a0a] text-white antialiased selection:bg-white selection:text-black">
      <style>{`
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap');
        *{font-family: Inter, ui-sans-serif, system-ui}
        .mono{font-family:"JetBrains Mono", monospace}
        ::-webkit-scrollbar{width:6px;height:6px}
        ::-webkit-scrollbar-thumb{background:#262626;border-radius:999px}
        ::-webkit-scrollbar-track{background:transparent}
        input, textarea { outline: none }
        @media print {
          header, aside, .no-print { display: none !important }
          .print-only { display: block !important }
          body, #root { background: white !important; color: black !important }
          .editor { border: none !important; box-shadow: none !important; margin:0 !important; padding:0 !important; }
        }
      `}</style>

      {/* Header */}
      <header className="sticky top-0 z-30 border-b border-neutral-800 bg-[#0a0a0a]/90 backdrop-blur-xl">
        <div className="mx-auto flex h-[64px] max-w-[1600px] items-center justify-between px-4 md:px-6">
          <div className="flex items-center gap-3">
            <div className="flex h-8 w-8 items-center justify-center rounded-lg bg-white text-black">
              <LayoutDashboard className="h-[18px] w-[18px]" />
            </div>
            <div className="flex items-baseline gap-2.5">
              <span className="text-[17px] font-semibold tracking-tight">QuoteSnap</span>
              <span className="hidden md:inline text-[11px] font-medium tracking-wide text-neutral-400 uppercase">Suite</span>
            </div>
            <div className="ml-3 hidden md:flex items-center gap-2 rounded-full border border-neutral-800 bg-neutral-900/70 px-2.5 py-1">
              <span className="h-1.5 w-1.5 animate-pulse rounded-full bg-emerald-400" />
              <span className="mono text-[10px] font-medium uppercase tracking-widest text-neutral-300">Sprint 1 — Live</span>
            </div>
          </div>

          <div className="flex items-center gap-2">
            <div className="md:hidden flex items-center gap-2 rounded-full border border-neutral-800 bg-neutral-900/70 px-2.5 py-1">
              <span className="h-1.5 w-1.5 animate-pulse rounded-full bg-emerald-400" />
              <span className="mono text-[10px] uppercase tracking-widest">Live</span>
            </div>
            <button
              onClick={newQuote}
              className="inline-flex items-center gap-2 rounded-full bg-white px-4 py-[9px] text-[13px] font-semibold text-black transition hover:bg-neutral-200 active:scale-[0.98]"
            >
              <Plus className="h-4 w-4" /> <span className="hidden sm:inline">New Quote</span><span className="sm:hidden">New</span>
            </button>
          </div>
        </div>
      </header>

      {/* Main */}
      <div className="mx-auto flex max-w-[1600px] flex-col md:flex-row md:h-[calc(100vh-64px)]">
        {/* Sidebar */}
        <aside className="no-print w-full border-b border-neutral-800 md:w-[380px] md:shrink-0 md:border-b-0 md:border-r bg-[#0a0a0a] flex flex-col">
          <div className="p-4 md:p-5 space-y-4">
            <div className="relative">
              <Search className="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-neutral-500" />
              <input
                value={search}
                onChange={(e) => setSearch(e.target.value)}
                placeholder="Search clients, sites, emails"
                className="w-full rounded-xl border border-neutral-800 bg-[#111111] py-2.5 pl-9 pr-3 text-[13px] text-white placeholder:text-neutral-500 focus:border-neutral-600 focus:bg-[#151515] transition"
              />
            </div>

            <div className="flex items-center gap-1.5 overflow-x-auto pb-1">
              {(["All", "Draft", "Sent", "Approved"] as const).map((s) => (
                <button
                  key={s}
                  onClick={() => setStatusFilter(s as any)}
                  className={`shrink-0 rounded-full border px-3 py-1.5 text-[12px] font-medium transition ${
                    statusFilter === s
                      ? "border-white bg-white text-black"
                      : "border-neutral-800 bg-[#111111] text-neutral-400 hover:border-neutral-700 hover:text-white"
                  }`}
                >
                  {s}
                </button>
              ))}
              <span className="ml-auto hidden md:flex items-center gap-1 mono text-[11px] text-neutral-500">
                <span className="h-3 w-px bg-neutral-800" />
                {filtered.length} quotes
              </span>
            </div>
          </div>

          <div className="flex-1 overflow-auto px-2 pb-4 md:px-3 space-y-2">
            {filtered.length === 0 ? (
              <div className="mx-2 mt-8 rounded-2xl border border-dashed border-neutral-800 bg-[#111111]/60 p-8 text-center">
                <div className="mx-auto mb-3 flex h-10 w-10 items-center justify-center rounded-full bg-neutral-900">
                  <FileText className="h-5 w-5 text-neutral-500" />
                </div>
                <p className="text-[13px] font-medium">No quotes yet</p>
                <p className="mt-1 text-[12px] leading-relaxed text-neutral-500">Create your first quote to see it here. Everything saves locally on this device for Sprint 1.</p>
                <button onClick={newQuote} className="mt-4 inline-flex items-center gap-1.5 rounded-full bg-white px-3.5 py-1.5 text-[12px] font-semibold text-black">
                  <Plus className="h-3.5 w-3.5" /> New Quote
                </button>
              </div>
            ) : (
              filtered.map((q) => {
                const { subtotal, total } = calcTotals(q.lineItems, q.taxRate, q.discount);
                const active = editing?.id === q.id;
                return (
                  <button
                    key={q.id}
                    onClick={() => setEditing(q)}
                    className={`group relative w-full rounded-[16px] border p-[14px] text-left transition ${
                      active
                        ? "border-white bg-[#151515] shadow-[0_0_0_1px_white]"
                        : "border-neutral-800 bg-[#111111] hover:border-neutral-700 hover:bg-[#151515]"
                    }`}
                  >
                    <div className="flex items-start justify-between gap-3">
                      <div className="min-w-0">
                        <p className="truncate text-[13.5px] font-semibold leading-tight">{q.clientName || "Untitled Client"}</p>
                        <p className="mt-1 flex items-center gap-1.5 text-[11px] text-neutral-500">
                          <Calendar className="h-3 w-3" /> {fmtDate(q.updatedAt)}
                          <span className="h-3 w-px bg-neutral-800" />
                          <span className="truncate">{q.jobSite?.slice(0,28) || q.email || "No site"}</span>
                        </p>
                      </div>
                      <span
                        className={`shrink-0 rounded-full border px-2 py-0.5 text-[10px] font-medium uppercase tracking-widest ${
                          q.status === "Draft"
                            ? "border-neutral-800 bg-neutral-900 text-neutral-400"
                            : q.status === "Sent"
                            ? "border-blue-500/20 bg-blue-500/10 text-blue-300"
                            : "border-emerald-500/20 bg-emerald-500/10 text-emerald-300"
                        }`}
                      >
                        {q.status}
                      </span>
                    </div>
                    <div className="mt-3 flex items-end justify-between">
                      <div className="flex items-center gap-1 text-neutral-400">
                        <DollarSign className="h-3.5 w-3.5" />
                        <span className="mono text-[12px]">{fmtCurrency(total)}</span>
                        <span className="ml-1 hidden text-[11px] text-neutral-600 group-hover:inline">• {q.lineItems.length} items</span>
                      </div>
                      <span className="mono text-[10px] text-neutral-600">{fmtCurrency(subtotal)} sub</span>
                    </div>
                  </button>
                );
              })
            )}
          </div>

          <div className="border-t border-neutral-800 p-3">
            <div className="flex items-center justify-between rounded-xl bg-[#111111] px-3 py-2.5">
              <div className="flex items-center gap-2">
                <div className="h-6 w-6 rounded-full bg-white text-black grid place-items-center text-[11px] font-bold">S1</div>
                <span className="text-[12px] font-medium text-neutral-300">Local-only • Sprint 1</span>
              </div>
              <MoreHorizontal className="h-4 w-4 text-neutral-600" />
            </div>
          </div>
        </aside>

        {/* Editor */}
        <div ref={editorRef} className="editor flex-1 overflow-auto bg-[#0a0a0a]">
          {!editing ? (
            <div className="flex h-full min-h-[60vh] flex-col items-center justify-center p-8 text-center">
              <div className="mb-6 flex h-14 w-14 items-center justify-center rounded-2xl bg-white text-black shadow-xl">
                <Sparkles className="h-7 w-7" />
              </div>
              <h2 className="max-w-[28rem] text-balance text-[28px] font-semibold leading-[1.1] tracking-tight md:text-[34px]">
                Professional quotes in under 2 minutes
              </h2>
              <p className="mt-3 max-w-[26rem] text-[14px] leading-relaxed text-neutral-400">
                Craft client-ready proposals with auto-calculations, taxes, discounts and polished previews. Saves locally for Sprint 1. Supabase sync lands in Sprint 2.
              </p>
              <div className="mt-8 flex gap-2">
                <button onClick={newQuote} className="rounded-full bg-white px-5 py-2.5 text-[13px] font-semibold text-black hover:bg-neutral-200">
                  Start a new quote
                </button>
                <button
                  onClick={() => filtered[0] && setEditing(filtered[0])}
                  className="rounded-full border border-neutral-800 bg-[#111111] px-5 py-2.5 text-[13px] font-medium text-neutral-300 hover:bg-[#151515] hover:text-white"
                >
                  Open recent
                </button>
              </div>
              <div className="mt-12 grid w-full max-w-[640px] grid-cols-1 gap-3 md:grid-cols-3 text-left">
                {[
                  { k: "01", t: "Client + Site", d: "Capture contact and job location" },
                  { k: "02", t: "Line items", d: "Qty × Rate auto-math, clean table" },
                  { k: "03", t: "Totals + Terms", d: "Tax, discount, notes, terms" },
                ].map((s) => (
                  <div key={s.k} className="rounded-2xl border border-neutral-800 bg-[#111111] p-4">
                    <div className="mono text-[11px] text-neutral-500">{s.k}</div>
                    <div className="mt-1 text-[13px] font-medium">{s.t}</div>
                    <div className="mt-1 text-[12px] text-neutral-500">{s.d}</div>
                  </div>
                ))}
              </div>
            </div>
          ) : (
            <div className="mx-auto max-w-[920px] p-4 md:p-8">
              {/* Top bar */}
              <div className="mb-6 flex flex-wrap items-center justify-between gap-3">
                <div className="flex items-center gap-3">
                  <h1 className="text-[18px] font-semibold tracking-tight">
                    {editing.clientName ? editing.clientName : "New Quote"}
                  </h1>
                  <span
                    className={`rounded-full border px-2.5 py-1 text-[10px] font-medium uppercase tracking-widest ${
                      editing.status === "Draft"
                        ? "border-neutral-800 bg-neutral-900 text-neutral-400"
                        : editing.status === "Sent"
                        ? "border-blue-500/20 bg-blue-500/10 text-blue-300"
                        : "border-emerald-500/20 bg-emerald-500/10 text-emerald-300"
                    }`}
                  >
                    {editing.status}
                  </span>
                  <span className="hidden md:inline mono text-[11px] text-neutral-600">ID {editing.id.slice(-6)}</span>
                </div>

                <div className="flex items-center gap-1.5">
                  <button
                    onClick={() => setPreviewOpen(true)}
                    className="inline-flex items-center gap-1.5 rounded-full border border-neutral-800 bg-[#111111] px-3 py-2 text-[12px] font-medium text-neutral-300 hover:bg-[#151515] hover:text-white"
                  >
                    <Eye className="h-3.5 w-3.5" /> Preview
                  </button>
                  <button
                    onClick={() => {
                      if (!editing) return;
                      const content = `QuoteSnap Quote - ${editing.clientName}\nTotal: ${fmtCurrency(totals.total)}\n\n${editing.lineItems.map((it,i)=>`${i+1}. ${it.description} - ${it.qty} x ${fmtCurrency(it.rate)} = ${fmtCurrency(it.qty*it.rate)}`).join('\n')}\n\nSubtotal: ${fmtCurrency(totals.subtotal)}\nTax: ${fmtCurrency(totals.taxAmount)}\nDiscount: ${fmtCurrency(editing.discount)}\nGrand Total: ${fmtCurrency(totals.total)}`;
                      const blob = new Blob([content], { type: 'text/plain' });
                      const url = URL.createObjectURL(blob);
                      const a = document.createElement('a');
                      a.href = url;
                      a.download = `Quote-${editing.clientName || 'draft'}.txt`;
                      a.click();
                      URL.revokeObjectURL(url);
                      setToast('Quote exported as text file');
                    }}
                    className="inline-flex items-center gap-1.5 rounded-full border border-neutral-800 bg-[#111111] px-3 py-2 text-[12px] font-medium text-neutral-300 hover:bg-[#151515] hover:text-white"
                  >
                    <Printer className="h-3.5 w-3.5" /> Export
                  </button>
                </div>
              </div>

              {/* Client Info */}
              <div className="rounded-[20px] border border-neutral-800 bg-[#111111] p-5 md:p-6">
                <div className="mb-4 flex items-center justify-between">
                  <h3 className="text-[13px] font-semibold uppercase tracking-widest text-neutral-200">Client & Job</h3>
                  <span className="mono text-[11px] text-neutral-500">Sprint 1 • local device</span>
                </div>

                <div className="grid grid-cols-1 gap-4 md:grid-cols-2">
                  <label className="space-y-1.5">
                    <span className="text-[11px] font-medium uppercase tracking-widest text-neutral-400">Client Name *</span>
                    <input
                      value={editing.clientName}
                      onChange={(e) => updateField("clientName", e.target.value)}
                      placeholder="e.g. Harrison Residence"
                      className="w-full rounded-xl border border-neutral-800 bg-[#0a0a0a] px-3.5 py-2.5 text-[14px] placeholder:text-neutral-600 focus:border-neutral-500 transition"
                    />
                  </label>
                  <label className="space-y-1.5">
                    <span className="text-[11px] font-medium uppercase tracking-widest text-neutral-400">Email</span>
                    <input
                      value={editing.email}
                      onChange={(e) => updateField("email", e.target.value)}
                      placeholder="client@email.com"
                      className="w-full rounded-xl border border-neutral-800 bg-[#0a0a0a] px-3.5 py-2.5 text-[14px] placeholder:text-neutral-600 focus:border-neutral-500 transition"
                    />
                  </label>
                  <label className="space-y-1.5">
                    <span className="text-[11px] font-medium uppercase tracking-widest text-neutral-400">Phone</span>
                    <input
                      value={editing.phone}
                      onChange={(e) => updateField("phone", e.target.value)}
                      placeholder="(555) 000-0000"
                      className="w-full rounded-xl border border-neutral-800 bg-[#0a0a0a] px-3.5 py-2.5 text-[14px] placeholder:text-neutral-600 focus:border-neutral-500 transition"
                    />
                  </label>
                  <label className="space-y-1.5">
                    <span className="text-[11px] font-medium uppercase tracking-widest text-neutral-400">Job Site Address</span>
                    <input
                      value={editing.jobSite}
                      onChange={(e) => updateField("jobSite", e.target.value)}
                      placeholder="Where the work happens"
                      className="w-full rounded-xl border border-neutral-800 bg-[#0a0a0a] px-3.5 py-2.5 text-[14px] placeholder:text-neutral-600 focus:border-neutral-500 transition"
                    />
                  </label>
                  <label className="space-y-1.5 md:col-span-2">
                    <span className="text-[11px] font-medium uppercase tracking-widest text-neutral-400">Billing Address</span>
                    <textarea
                      value={editing.address}
                      onChange={(e) => updateField("address", e.target.value)}
                      placeholder="Street, city, state, zip"
                      rows={2}
                      className="w-full resize-none rounded-xl border border-neutral-800 bg-[#0a0a0a] px-3.5 py-2.5 text-[14px] placeholder:text-neutral-600 focus:border-neutral-500 transition"
                    />
                  </label>
                </div>
              </div>

              {/* Line Items */}
              <div className="mt-5 rounded-[20px] border border-neutral-800 bg-[#111111] p-5 md:p-6">
                <div className="mb-4 flex items-center justify-between">
                  <h3 className="text-[13px] font-semibold uppercase tracking-widest text-neutral-200">Line Items</h3>
                  <button
                    onClick={addItem}
                    className="inline-flex items-center gap-1.5 rounded-full bg-white px-3 py-1.5 text-[12px] font-semibold text-black hover:bg-neutral-200"
                  >
                    <Plus className="h-3.5 w-3.5" /> Add item
                  </button>
                </div>

                {/* Desktop table header */}
                <div className="hidden md:grid grid-cols-[32px_1fr_96px_128px_128px_36px] gap-2 px-1 pb-2 mono text-[10px] uppercase tracking-widest text-neutral-500">
                  <span>#</span>
                  <span>Description</span>
                  <span>Qty</span>
                  <span>Rate</span>
                  <span className="text-right">Amount</span>
                  <span />
                </div>

                <div className="space-y-2">
                  {editing.lineItems.map((it, idx) => (
                    <div
                      key={it.id}
                      className="group grid grid-cols-1 gap-2 rounded-xl border border-neutral-800 bg-[#0a0a0a] p-3 md:grid-cols-[32px_1fr_96px_128px_128px_36px] md:items-center md:p-2"
                    >
                      <span className="hidden md:block mono text-[12px] text-neutral-500">{String(idx + 1).padStart(2, "0")}</span>

                      <input
                        value={it.description}
                        onChange={(e) => updateItem(it.id, { description: e.target.value })}
                        placeholder={idx === 0 ? "e.g. Kitchen cabinet install" : "Item description"}
                        className="w-full rounded-lg border border-transparent bg-[#151515] px-3 py-2 text-[13px] placeholder:text-neutral-600 focus:border-neutral-700 focus:bg-[#171717] md:bg-transparent md:px-2 md:py-2"
                      />

                      <div className="flex gap-2 md:contents">
                        <input
                          type="number"
                          min={0}
                          value={it.qty}
                          onChange={(e) => updateItem(it.id, { qty: parseFloat(e.target.value) || 0 })}
                          className="w-full rounded-lg border border-neutral-800 bg-[#151515] px-3 py-2 text-[13px] mono focus:border-neutral-600 md:bg-[#111111]"
                        />
                        <div className="relative w-full">
                          <span className="pointer-events-none absolute left-2.5 top-1/2 -translate-y-1/2 text-[12px] text-neutral-500">$</span>
                          <input
                            type="number"
                            min={0}
                            value={it.rate}
                            onChange={(e) => updateItem(it.id, { rate: parseFloat(e.target.value) || 0 })}
                            className="w-full rounded-lg border border-neutral-800 bg-[#151515] pl-6 pr-3 py-2 text-[13px] mono focus:border-neutral-600 md:bg-[#111111]"
                          />
                        </div>
                        <div className="hidden md:flex items-center justify-end pr-2 mono text-[13px] font-medium">
                          {fmtCurrency(it.qty * it.rate)}
                        </div>
                        <button
                          onClick={() => removeItem(it.id)}
                          className="grid h-9 w-9 place-items-center rounded-lg border border-transparent text-neutral-500 hover:border-neutral-800 hover:bg-neutral-900 hover:text-white md:h-8 md:w-8"
                        >
                          <Trash2 className="h-4 w-4" />
                        </button>
                      </div>

                      <div className="flex items-center justify-between md:hidden">
                        <span className="mono text-[11px] text-neutral-500">Amount</span>
                        <span className="mono text-[13px] font-medium">{fmtCurrency(it.qty * it.rate)}</span>
                      </div>
                    </div>
                  ))}
                </div>

                <div className="mt-4 flex justify-end">
                  <div className="rounded-xl bg-[#0a0a0a] px-4 py-2 mono text-[12px] text-neutral-400">
                    Subtotal: <span className="text-white font-medium">{fmtCurrency(totals.subtotal)}</span>
                  </div>
                </div>
              </div>

              {/* Totals + Notes */}
              <div className="mt-5 grid grid-cols-1 gap-5 md:grid-cols-[1.1fr_0.9fr]">
                <div className="space-y-5">
                  <div className="rounded-[20px] border border-neutral-800 bg-[#111111] p-5 md:p-6">
                    <h3 className="mb-4 text-[13px] font-semibold uppercase tracking-widest text-neutral-200">Additional</h3>
                    <div className="space-y-4">
                      <label className="block space-y-1.5">
                        <span className="text-[11px] font-medium uppercase tracking-widest text-neutral-400">Notes (client-facing)</span>
                        <textarea
                          value={editing.notes}
                          onChange={(e) => updateField("notes", e.target.value)}
                          rows={3}
                          placeholder="Scope details, deposit, timeline..."
                          className="w-full resize-none rounded-xl border border-neutral-800 bg-[#0a0a0a] px-3.5 py-2.5 text-[13px] leading-relaxed placeholder:text-neutral-600 focus:border-neutral-500"
                        />
                      </label>
                      <label className="block space-y-1.5">
                        <span className="text-[11px] font-medium uppercase tracking-widest text-neutral-400">Terms & Conditions</span>
                        <textarea
                          value={editing.terms}
                          onChange={(e) => updateField("terms", e.target.value)}
                          rows={3}
                          className="w-full resize-none rounded-xl border border-neutral-800 bg-[#0a0a0a] px-3.5 py-2.5 text-[13px] leading-relaxed placeholder:text-neutral-600 focus:border-neutral-500"
                        />
                      </label>
                    </div>
                  </div>
                </div>

                <div className="rounded-[20px] border border-neutral-800 bg-[#111111] p-5 md:p-6">
                  <h3 className="mb-4 text-[13px] font-semibold uppercase tracking-widest text-neutral-200">Totals</h3>

                  <div className="space-y-3">
                    <div className="flex items-center justify-between text-[13px]">
                      <span className="text-neutral-400">Subtotal</span>
                      <span className="mono font-medium">{fmtCurrency(totals.subtotal)}</span>
                    </div>

                    <label className="flex items-center justify-between gap-3 rounded-xl border border-neutral-800 bg-[#0a0a0a] px-3 py-2.5">
                      <span className="text-[12px] text-neutral-400">Tax %</span>
                      <div className="flex items-center gap-2">
                        <input
                          type="number"
                          value={editing.taxRate}
                          onChange={(e) => updateField("taxRate", parseFloat(e.target.value) || 0)}
                          className="w-[64px] rounded-lg border border-neutral-800 bg-[#151515] px-2 py-1 text-right mono text-[13px] focus:border-neutral-600"
                        />
                        <span className="mono text-[11px] text-neutral-500">%</span>
                      </div>
                    </label>

                    <div className="flex items-center justify-between text-[12px] text-neutral-500">
                      <span>Tax amount</span>
                      <span className="mono">{fmtCurrency(totals.taxAmount)}</span>
                    </div>

                    <label className="flex items-center justify-between gap-3 rounded-xl border border-neutral-800 bg-[#0a0a0a] px-3 py-2.5">
                      <span className="text-[12px] text-neutral-400">Discount</span>
                      <div className="flex items-center gap-1">
                        <span className="text-[12px] text-neutral-500">$</span>
                        <input
                          type="number"
                          value={editing.discount}
                          onChange={(e) => updateField("discount", parseFloat(e.target.value) || 0)}
                          className="w-[84px] rounded-lg border border-neutral-800 bg-[#151515] px-2 py-1 text-right mono text-[13px] focus:border-neutral-600"
                        />
                      </div>
                    </label>

                    <div className="my-3 h-px bg-neutral-800" />

                    <div className="flex items-center justify-between">
                      <span className="text-[13px] font-semibold">Grand Total</span>
                      <span className="mono text-[22px] font-semibold tracking-tight">{fmtCurrency(totals.total)}</span>
                    </div>

                    <div className="mt-4 grid grid-cols-2 gap-2">
                      <button
                        onClick={saveQuote}
                        className="inline-flex items-center justify-center gap-2 rounded-full bg-white py-2.5 text-[13px] font-semibold text-black hover:bg-neutral-200 active:scale-[0.98] transition"
                      >
                        <Check className="h-4 w-4" /> Save Quote
                      </button>
                      <button
                        onClick={markSent}
                        className="inline-flex items-center justify-center gap-2 rounded-full border border-neutral-800 bg-[#0a0a0a] py-2.5 text-[13px] font-medium text-white hover:bg-[#151515] transition"
                      >
                        <Send className="h-4 w-4" /> Mark Sent
                      </button>
                      <button
                        onClick={handleSendMock}
                        className="col-span-2 inline-flex items-center justify-center gap-2 rounded-full bg-[#151515] border border-neutral-800 py-2.5 text-[13px] font-medium text-neutral-200 hover:bg-[#1a1a1a] hover:text-white transition"
                      >
                        <Send className="h-4 w-4" /> Send (mock)
                      </button>
                    </div>

                    <p className="mt-3 text-center mono text-[10px] leading-relaxed text-neutral-500">
                      Saves to localStorage key <span className="text-neutral-400">quotesnap-quotes</span>. Supabase in Sprint 2.
                    </p>
                  </div>
                </div>
              </div>

              {/* Bottom spacer */}
              <div className="h-12" />
            </div>
          )}
        </div>
      </div>

      {/* Preview Modal */}
      {previewOpen && editing && (
        <div className="fixed inset-0 z-50 flex">
          <div className="absolute inset-0 bg-black/80 backdrop-blur-sm" onClick={() => setPreviewOpen(false)} />
          <div className="relative m-auto max-h-[92vh] w-[96%] max-w-[820px] overflow-auto rounded-[24px] border border-neutral-800 bg-white p-0 text-black shadow-2xl">
            <div className="sticky top-0 z-10 flex items-center justify-between border-b border-neutral-200 bg-white/90 px-6 py-4 backdrop-blur">
              <div className="flex items-center gap-3">
                <div className="h-8 w-8 rounded-lg bg-black text-white grid place-items-center">
                  <FileText className="h-4 w-4" />
                </div>
                <div>
                  <p className="text-[13px] font-semibold">Quote Preview</p>
                  <p className="mono text-[11px] text-neutral-500">{editing.id} • {editing.status}</p>
                </div>
              </div>
              <div className="flex items-center gap-2">
                <button
                  onClick={() => {
                    const content = `QuoteSnap Quote - ${editing.clientName}\nTotal: ${fmtCurrency(totals.total)}\n\n${editing.lineItems.map((it,i)=>`${i+1}. ${it.description} - ${it.qty} x ${fmtCurrency(it.rate)} = ${fmtCurrency(it.qty*it.rate)}`).join('\n')}\n\nSubtotal: ${fmtCurrency(totals.subtotal)}\nTax: ${fmtCurrency(totals.taxAmount)}\nDiscount: ${fmtCurrency(editing.discount)}\nGrand Total: ${fmtCurrency(totals.total)}`;
                    const blob = new Blob([content], { type: 'text/plain' });
                    const url = URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = `Quote-${editing.clientName || 'draft'}.txt`;
                    a.click();
                    URL.revokeObjectURL(url);
                    setToast('Quote exported');
                  }}
                  className="rounded-full bg-black px-4 py-2 text-[12px] font-medium text-white"
                >
                  Export TXT
                </button>
                <button onClick={() => setPreviewOpen(false)} className="grid h-8 w-8 place-items-center rounded-full border border-neutral-200">
                  <X className="h-4 w-4" />
                </button>
              </div>
            </div>

            <div className="p-8 md:p-10">
              <div className="flex justify-between gap-8">
                <div>
                  <h1 className="text-[22px] font-bold tracking-tight">QuoteSnap</h1>
                  <p className="mono text-[11px] uppercase tracking-widest text-neutral-500">Professional Services Estimate</p>
                </div>
                <div className="text-right">
                  <p className="text-[13px] font-medium">{fmtDate(editing.updatedAt)}</p>
                  <p className="mono text-[11px] text-neutral-500">Quote {editing.id.slice(-8).toUpperCase()}</p>
                </div>
              </div>

              <div className="mt-8 grid grid-cols-1 gap-8 md:grid-cols-2">
                <div>
                  <p className="mono text-[10px] uppercase tracking-widest text-neutral-500">Bill To</p>
                  <p className="mt-2 text-[14px] font-semibold">{editing.clientName || "—"}</p>
                  <p className="text-[13px] text-neutral-600">{editing.email}</p>
                  <p className="text-[13px] text-neutral-600">{editing.phone}</p>
                  <p className="mt-2 text-[12px] leading-relaxed text-neutral-600 whitespace-pre-wrap">{editing.address}</p>
                </div>
                <div>
                  <p className="mono text-[10px] uppercase tracking-widest text-neutral-500">Job Site</p>
                  <p className="mt-2 text-[13px] leading-relaxed text-neutral-700 whitespace-pre-wrap">{editing.jobSite || "—"}</p>
                </div>
              </div>

              <div className="mt-8 overflow-hidden rounded-xl border border-neutral-200">
                <div className="grid grid-cols-[32px_1fr_80px_100px_110px] gap-2 bg-neutral-50 px-4 py-2.5 mono text-[10px] uppercase tracking-widest text-neutral-500">
                  <span>#</span><span>Description</span><span>Qty</span><span>Rate</span><span className="text-right">Amount</span>
                </div>
                {editing.lineItems.map((it, idx) => (
                  <div key={it.id} className="grid grid-cols-[32px_1fr_80px_100px_110px] gap-2 border-t border-neutral-200 px-4 py-3 text-[13px]">
                    <span className="mono text-neutral-500">{idx + 1}</span>
                    <span>{it.description || <span className="text-neutral-400">No description</span>}</span>
                    <span className="mono">{it.qty}</span>
                    <span className="mono">{fmtCurrency(it.rate)}</span>
                    <span className="mono text-right font-medium">{fmtCurrency(it.qty * it.rate)}</span>
                  </div>
                ))}
              </div>

              <div className="mt-6 flex justify-end">
                <div className="w-full max-w-[320px] space-y-2 rounded-xl bg-neutral-50 p-4">
                  <div className="flex justify-between text-[13px]"><span className="text-neutral-500">Subtotal</span><span className="mono font-medium">{fmtCurrency(totals.subtotal)}</span></div>
                  <div className="flex justify-between text-[12px]"><span className="text-neutral-500">Tax ({editing.taxRate}%)</span><span className="mono">{fmtCurrency(totals.taxAmount)}</span></div>
                  <div className="flex justify-between text-[12px]"><span className="text-neutral-500">Discount</span><span className="mono">-{fmtCurrency(editing.discount)}</span></div>
                  <div className="mt-2 flex justify-between border-t border-neutral-200 pt-3 text-[14px] font-semibold"><span>Grand Total</span><span className="mono text-[18px]">{fmtCurrency(totals.total)}</span></div>
                </div>
              </div>

              {(editing.notes || editing.terms) && (
                <div className="mt-8 grid grid-cols-1 gap-6 md:grid-cols-2">
                  <div><p className="mono text-[10px] uppercase tracking-widest text-neutral-500">Notes</p><p className="mt-2 text-[12px] leading-relaxed text-neutral-700 whitespace-pre-wrap">{editing.notes || "—"}</p></div>
                  <div><p className="mono text-[10px] uppercase tracking-widest text-neutral-500">Terms</p><p className="mt-2 text-[12px] leading-relaxed text-neutral-700 whitespace-pre-wrap">{editing.terms || "—"}</p></div>
                </div>
              )}

              <p className="mt-10 text-center mono text-[10px] text-neutral-400">Generated with QuoteSnap Suite — Sprint 1 • {new Date().getFullYear()}</p>
            </div>
          </div>
        </div>
      )}

      {/* Toast */}
      {toast && (
        <div className="pointer-events-none fixed bottom-4 left-1/2 z-[60] flex -translate-x-1/2 items-center gap-2 rounded-full border border-neutral-800 bg-[#151515] px-4 py-2.5 shadow-2xl">
          <div className="h-2 w-2 rounded-full bg-emerald-400 animate-pulse" />
          <span className="text-[12px] font-medium text-white">{toast}</span>
        </div>
      )}
    </div>
  );
}
